    {
      "parameters": {
        "jsCode": "const temp = $('HTTP Request').item.json.current_weather.temperature;\nconst cidade = $('Webhook').item.json.body.cidade;\nlet recomendacao = \"\";\n\nif (temp < 15) {\n    recomendacao = `[IA Simulada] Em ${cidade} está fazendo ${temp}°C. Está bem frio! Recomendo usar um casaco pesado, cachecol e priorizar atividades em locais fechados, como museus ou cafés.`;\n} else if (temp >= 15 && temp <= 25) {\n    recomendacao = `[IA Simulada] O clima em ${cidade} está agradável (${temp}°C). Uma calça leve e uma camiseta/camisa de manga longa são ideais. Perfeito para uma caminhada no parque!`;\n} else {\n    recomendacao = `[IA Simulada] Está calor em ${cidade} (${temp}°C)! Use roupas bem leves, óculos de sol, beba bastante água e aproveite atividades ao ar livre ou uma praia/piscina.`;\n}\n\nreturn { text: recomendacao };\n"
      },
